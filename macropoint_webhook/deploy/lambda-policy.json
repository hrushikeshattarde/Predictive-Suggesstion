{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadWriteLatestPings",
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:PutObject"],
      "Resource": "arn:aws:s3:::{{BUCKET}}/{{PREFIX}}*"
    },
    {
      "Sid": "ListForMissingKeys",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::{{BUCKET}}",
      "Condition": {"StringLike": {"s3:prefix": ["{{PREFIX}}*"]}}
    }
  ]
}
